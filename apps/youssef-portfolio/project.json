{
  "name": "youssef-portfolio",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/youssef-portfolio/src",
  "tags": [],
  "i18n": {
    "sourceLocale": {
      "code": "en",
      "subPath": ""
    },
    "locales": {
      "ar": {
        "translation": "apps/youssef-portfolio/src/locale/messages.ar.json",
        "subPath": "ar"
      }
    }
  },
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": [
        "{options.outputPath}"
      ],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/youssef-portfolio",
        "browser": "apps/youssef-portfolio/src/main.ts",
        "tsConfig": "apps/youssef-portfolio/tsconfig.app.json",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/youssef-portfolio/public"
          }
        ],
        "styles": [
          "apps/youssef-portfolio/src/styles.css"
        ],
        "server": "apps/youssef-portfolio/src/main.server.ts",
        "outputMode": "static",
        "polyfills": [
          "@angular/localize/init"
        ]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "16kb",
              "maximumError": "20kb"
            }
          ],
          "outputHashing": "all",
          "localize": true
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        },
        "development-ar": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true,
          "localize": [
            "ar"
          ]
        }
      }
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "configurations": {
        "production": {
          "buildTarget": "youssef-portfolio:build:production"
        },
        "development": {
          "buildTarget": "youssef-portfolio:build:development"
        },
        "development-ar": {
          "buildTarget": "youssef-portfolio:build:development-ar"
        }
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": [
        "{workspaceRoot}/coverage/{projectRoot}"
      ],
      "options": {
        "jestConfig": "apps/youssef-portfolio/jest.config.cts",
        "tsConfig": "apps/youssef-portfolio/tsconfig.spec.json"
      }
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "youssef-portfolio:build",
        "port": 4200,
        "staticFilePath": "dist/apps/youssef-portfolio/browser",
        "spa": false
      }
    },
    "extract-i18n": {
      "executor": "@angular/build:extract-i18n",
      "options": {
        "buildTarget": "youssef-portfolio:build",
        "format": "json",
        "outputPath": "apps/youssef-portfolio/src/locale"
      }
    }
  }
}
